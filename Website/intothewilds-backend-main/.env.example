# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Server ----
PORT=5000
NODE_ENV=development
# Set to "true" to relax the OTP-email localhost check in authController.js
# during local development.
LOCAL_DEV=false
# Used by the isLocalDev() check in controller/authController.js.
ORIGIN=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# ---- CORS ----
# Comma-separated list of allowed browser origins (no spaces needed, they're trimmed).
CORS_ORIGINS=http://localhost:5173,https://intothewildstays.com

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string

# ---- Google Sign-In ----
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ---- Outbound email (registration OTPs, contact/query notifications, login alerts) ----
# All mailers in this app (controller/authController.js, contactController.js,
# eventQueryController.js, toursQueryController.js,
# propertyListingQueryController.js, utils/email.js) read these same two vars.
EMAIL_USER=your-smtp-or-gmail-address@example.com
EMAIL_PASS=your-smtp-or-app-password
# Only controller/authController.js's transporter also needs these two —
# the other controllers use nodemailer's Gmail shorthand instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# ---- SMS OTP (Fast2SMS) ----
FAST2SMS_API_KEY=your-fast2sms-api-key

# ---- Payments (Razorpay) ----
# NOT currently wired up — controller/bookingController.js intentionally
# stubs order creation instead of calling Razorpay. Set these and uncomment
# the real integration there before going live. See KNOWN_ISSUES.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Cloudinary (scripts/wire-cloudinary.js only) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=itw/uploads

# ---- One-time admin seed (scripts/seedAdmin.js / `npm run seed:admin`) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
