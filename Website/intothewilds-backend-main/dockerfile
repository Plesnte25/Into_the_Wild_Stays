# Step 1: Set the base image (Node.js image)
# Matches the "engines.node": ">=20.x" requirement in package.json.
FROM node:20

# Step 2: Set the working directory inside the container
WORKDIR /usr/src/app

# Step 3: Copy the package.json and package-lock.json files
COPY package*.json ./

# Step 4: Install the dependencies
RUN npm install --omit=dev

# Step 5: Copy the rest of the application files
COPY . .

# Step 6: Expose the port the app will run on.
# server.js listens on process.env.PORT, defaulting to 5000 — set PORT to
# override at run time (e.g. `docker run -e PORT=5000 ...`).
EXPOSE 5000

# Step 7: Run the app
CMD ["npm", "start"]
