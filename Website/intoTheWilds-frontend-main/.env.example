# Copy this file to .env (or .env.local) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code —
# never put server-only secrets here, they end up in the public bundle.

# Base URL of the backend API (see Website/intothewilds-backend-main),
# e.g. http://localhost:5000/api in local dev, or the deployed API origin.
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth client ID used by @react-oauth/google (src/main.jsx).
# Create one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Razorpay publishable "Key ID" (NOT the secret key) used to open the
# Razorpay Checkout widget (src/components/Checkout.jsx). Get this from the
# Razorpay dashboard. Use a rzp_test_... key outside production.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
