# Base URL of the Into The Wild Stays backend API that this admin panel talks to.
#
# - Leave unset (or set to "/api") when the API is reverse-proxied on the same
#   origin as this app (e.g. Nginx forwarding /api -> the backend service).
#   This is also what the Vite dev server proxy in vite.config.js expects.
# - Set to an absolute URL when the API is hosted on a different domain or
#   sub-domain than this admin app, e.g.:
#     VITE_API_BASE=https://api.intothewildstays.com/api
#
# All API clients in this app (src/lib/axios.js, src/lib/api.js,
# src/lib/ChannelApi.js, src/store/auth.jsx, src/pages/Login.jsx) fall back to
# the relative "/api" path if this is left unset, so a missing value fails
# safely instead of pointing a production build at a developer's localhost.
VITE_API_BASE=/api
