# intothewilds-admin-backend — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# REQUIRED — the server exits at boot if any of these are missing.
# ---------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_RESET_SECRET=replace-with-yet-another-long-random-string

# ---------------------------------------------------------------------------
# Server / networking
# ---------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed admin-frontend origins (matches the CORS_ORIGINS
# convention used by the sibling Website/intothewilds-backend-main).
CORS_ORIGINS=http://localhost:5173
# Set to "true" in production (HTTPS) so the refresh-token cookie requires HTTPS.
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5174

# ---------------------------------------------------------------------------
# Auth / JWT tuning (optional — sane defaults exist in code)
# ---------------------------------------------------------------------------
JWT_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# MongoDB (optional overrides)
# ---------------------------------------------------------------------------
MONGO_DB=itw

# ---------------------------------------------------------------------------
# Cloudinary (required for image uploads to work; app boots without it but
# upload endpoints will return errors)
# ---------------------------------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=itw/uploads

# ---------------------------------------------------------------------------
# Razorpay (payments)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# ---------------------------------------------------------------------------
# SMTP (email) — if SMTP_HOST is unset, mail is logged to console instead of sent
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ITW" <no-reply@intothewildstays.in>
NOTIFY_ADMIN=

# ---------------------------------------------------------------------------
# Business / invoicing
# ---------------------------------------------------------------------------
BUSINESS_NAME=Into The Wild Stays
BUSINESS_ADDRESS_LINE1=
BUSINESS_ADDRESS_LINE2=
BUSINESS_GSTIN=
INVOICE_PREFIX=ITW

# ---------------------------------------------------------------------------
# Public booking flow (routes/public.routes.js) tuning
# ---------------------------------------------------------------------------
QUOTE_TTL_MIN=15
BOOKING_HOLD_TTL_MIN=15
PLATFORM_FEE_RATE_DEFAULT=
CHANNEL_FEE_RATE_DEFAULT=
TAX_RATE_DEFAULT=

# ---------------------------------------------------------------------------
# Dashboard / caching
# ---------------------------------------------------------------------------
DASHBOARD_CACHE_TTL=900
# If unset, services/cache.service.js falls back to an in-memory cache
# (fine for a single instance/dev; use Redis for multi-instance deployments).
REDIS_URL=

# ---------------------------------------------------------------------------
# One-off scripts (scripts/seedAdmin.js)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@intothewildstays.in
SEED_ADMIN_PHONE=+911234567890
SEED_ADMIN_PASSWORD=change-me
